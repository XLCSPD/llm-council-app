# LLM Council Docker Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Supabase Configuration
# ===========================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend uses these (will be baked into the build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# OpenRouter API
# ===========================================
# Get this from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# ===========================================
# Orchestrator URL (for frontend)
# ===========================================
# In production, this should be your orchestrator's public URL
# For local Docker, use the service name or localhost
VITE_ORCHESTRATOR_URL=http://localhost:8002

# ===========================================
# Debug Mode (optional)
# ===========================================
DEBUG=false
